# ===================================================================
# Corn Fodder — environment
# ===================================================================
# Copy to .env.local for development, and set the same values in your
# host's environment for production.
#
# RULE: anything prefixed NEXT_PUBLIC_ is compiled into the browser
# bundle and is visible to everyone. Never put an API key, a database
# credential or a webhook secret behind that prefix. Server-only values
# below have no prefix and stay on the server.
#
# Check your configuration with:  npm run launch:audit
# ===================================================================


# -------------------------------------------------------------------
# PUBLIC — safe to expose
# -------------------------------------------------------------------

# The canonical public origin. Drives canonical tags, sitemap, robots,
# Open Graph, structured data and every share URL.
# No trailing slash. Must be https in production.
# A production build with example.com or localhost here is a launch
# blocker — see lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: POST quote submissions to an EXTERNAL endpoint instead of
# this app's own /api/quote route. Leave unset for the normal setup.
# Contract: docs/QUOTE-API.md
# NEXT_PUBLIC_FORMS_ENDPOINT=https://api.example.com/enquiries


# -------------------------------------------------------------------
# SERVER — never prefixed, never committed
# -------------------------------------------------------------------
# The RFQ route needs at least ONE destination configured. With none,
# /api/quote answers 503 and the site tells visitors plainly that their
# request was not sent. That refusal is deliberate — see
# app/api/quote/route.ts.

# --- Durable storage (strongly preferred) --------------------------
# POST each request as JSON to a URL you control: your own API, a
# database function, or an automation that writes to a CRM or a sheet.
# This is what decides whether a submission counts as delivered.
# QUOTE_WEBHOOK_URL=https://api.example.com/corn-fodder/quotes
# Optional bearer token sent with the above.
# QUOTE_WEBHOOK_SECRET=

# Development shortcut: print submissions to the server log instead of
# storing them. IGNORED in production — a log line is not a record.
# QUOTE_STORE=log

# --- Sales notification --------------------------------------------
# Any mail API with a JSON POST /emails endpoint. Defaults to Resend's
# shape; change QUOTE_EMAIL_ENDPOINT for another provider.
# Notification failure never loses a stored RFQ.
# QUOTE_EMAIL_API_KEY=
# QUOTE_EMAIL_FROM=quotes@yourdomain.com
# QUOTE_EMAIL_TO=sales@yourdomain.com          # comma-separated for several
# QUOTE_EMAIL_ENDPOINT=https://api.resend.com/emails

# Send the buyer an acknowledgement as well. Off by default: it promises
# no response time, but it is still an email to a customer.
# QUOTE_EMAIL_CONFIRM_BUYER=true

# Or ping a webhook (Slack, Teams, n8n, Zapier) on each new request.
# QUOTE_NOTIFY_WEBHOOK_URL=

# --- Abuse protection ----------------------------------------------
# Per-IP limit on /api/quote. Defaults: 12 requests per 10 minutes.
# Deliberately generous — a shared office IP must not be locked out.
# QUOTE_RATE_MAX=12
# QUOTE_RATE_WINDOW_MS=600000


# -------------------------------------------------------------------
# ANALYTICS (optional)
# -------------------------------------------------------------------
# No provider is wired. Enable `features.analyticsEnabled` in
# data/site-config.ts AND install a sink via setAnalyticsSink()
# (lib/analytics.ts). Only then does any event leave the browser.
# Personal data is stripped before a provider can see it.
# NEXT_PUBLIC_ANALYTICS_KEY=


# -------------------------------------------------------------------
# DATABASE + ADMIN PANEL (optional)
# -------------------------------------------------------------------
# Together these turn on /admin: a quote-request inbox and a product
# editor. The site works fully without them — the panel is additive.
#
# Setup, once:
#   1. Create a Supabase project (the free tier is ample).
#   2. Run docs/sql/001-init.sql in its SQL editor.
#   3. Copy the URL and the SERVICE ROLE key below.
#   4. Run `npm run admin:password` and paste its two lines below.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security — it is a full
# database credential. It is read only on the server. NEVER rename any
# of these four with a NEXT_PUBLIC_ prefix: that compiles the value
# into the browser bundle, which for these is a total compromise. The
# launch audit fails the build if you do.
#
# Use the SECRET key (sb_secret_… , or the legacy service_role JWT).
# A publishable/anon key will NOT work: this schema enables row-level
# security with no policies, so those keys can reach nothing.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Once SUPABASE_URL and the service key are set, quote requests are
# stored in Postgres and readable at /admin/requests. This is what
# closes the "no durable storage" launch blocker.

# From `npm run admin:password`. The hash is scrypt, so the password
# itself is never stored. Rotating ADMIN_SESSION_SECRET signs everyone
# out immediately — that is how you revoke access.
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=

# --- Reverse proxy ---------------------------------------------------
# Which proxy sits in front, if any. This decides whether the rate
# limiter may trust a vendor IP header — one that is NOT stripped by a
# proxy can be forged by the caller to mint a fresh throttle bucket per
# request. Leave unset unless the proxy really is in front.
#   cloudflare  trust cf-connecting-ip
#   nginx       trust x-real-ip
# Vercel is detected automatically via its own VERCEL variable.
# TRUSTED_PROXY=cloudflare
