{
  "name": "silvora",
  "version": "1.0.0",
  "private": true,
  "description": "SILVORA \u2014 premium corn silage bales. Next.js App Router site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-data.mts",
    "launch:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/launch-audit.mts",
    "preflight": "npm run validate:data && npm run typecheck && npm run lint && npm run launch:audit",
    "i18n:review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-review.mts"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
